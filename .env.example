# Canonical env template — copy to .env.local and fill in.
# .env.local is used BOTH by local dev and mirrored to Vercel (Production).

# Neon PostgreSQL connection string (permanent project)
DATABASE_URL=

# Unpooled direct connection for migrations/tools (bypasses pgbouncer)
DATABASE_URL_UNPOOLED=

# NextAuth v5 secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Public app URL — set to the production URL on Vercel
AUTH_URL=

# Receipt storage driver: "local" (dev, /public/uploads) or "blob" (Vercel Blob)
STORAGE_DRIVER=local

# Required only when STORAGE_DRIVER=blob (Vercel Blob token)
STORAGE_BLOB_READ_WRITE_TOKEN=