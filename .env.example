# Neon PostgreSQL (dev database — provisioned via `npm run db:provision`)
DATABASE_URL=

# NextAuth v5 secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Set to production on Vercel (comma-separated for preview)
AUTH_URL=

# Receipt storage driver: "local" (dev, /public/uploads) or "blob" (Vercel Blob)
STORAGE_DRIVER=local

# Required only when STORAGE_DRIVER=blob (Vercel Blob token)
# Also stores the active-DB pointer + rotation lock for `db:rotate`
# (prod Neon.new DBs are ephemeral — cron rotates before expiry).
STORAGE_BLOB_READ_WRITE_TOKEN=

# Guards /api/cron/rotate-db. Set the SAME value in two places:
#   - Vercel env (Vercel cron sends `Authorization: Bearer $CRON_SECRET`)
#   - GitHub repo secret `CRON_SECRET` (hourly rotation workflow)
# Also add GitHub variable `PROD_URL` (e.g. https://jejakuang.vercel.app).
# Note: Vercel Hobby cron runs once per day max — the hourly cadence is
# provided by the GitHub Actions `rotate-db` workflow in this repo.
CRON_SECRET=